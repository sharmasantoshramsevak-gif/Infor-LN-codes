            </TaxPeriod>

            <Ledger>
                <xsl:value-of select="$claim/*[local-name()='Ledger']"/>
            </Ledger>

            <LNStatus>
                <xsl:value-of select="$claim/*[local-name()='LNStatus']"/>
            </LNStatus>

            <PaymentDate>
                <xsl:value-of select="$claim/*[local-name()='PaymentDate']"/>
            </PaymentDate>

            <PaymentAmount>
                <xsl:value-of select="$claim/*[local-name()='PaymentAmount']"/>
            </PaymentAmount>

            <PaymentReferenceNumber>
                <xsl:value-of select="$claim/*[local-name()='PaymentReferenceNumber']"/>
            </PaymentReferenceNumber>

            <EmployeeCode>

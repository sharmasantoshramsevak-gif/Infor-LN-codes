            </PayToBusinessPartner>

            <DocumentDate>
                <xsl:value-of select="$claim/*[local-name()='DocumentDate']"/>
            </DocumentDate>

            <DocumentType>
                <xsl:value-of select="$claim/*[local-name()='DocumentType']"/>
            </DocumentType>

            <Currency>
